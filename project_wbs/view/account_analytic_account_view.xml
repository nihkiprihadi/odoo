<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_account_analytic_account_list" model="ir.ui.view">
        <field name="name">account.analytic.account.list.wbs</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_list" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="parent_id" optional="hide" />
                <field name="account_class" optional="show" />
                <field name="complete_wbs_code" string="WBS Code" optional="show" />
                <field name="project_analytic_id" optional="hide" />
                <field name="manager_id" optional="hide" />
            </field>
        </field>
    </record>

    <record id="view_account_analytic_account_search" model="ir.ui.view">
        <field name="name">account.analytic.account.search.wbs</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_search" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="complete_wbs_name" string="WBS Name" />
                <field name="complete_wbs_code" string="WBS Code" />
                <field name="account_class" string="Class" />
                <field name="project_analytic_id" />
            </field>
            <xpath expr="//group" position="inside">
                <filter
                    string="Master Project"
                    name="group_by_project_analytic_id"
                    context="{'group_by': 'project_analytic_id'}"
                />
            </xpath>
        </field>
    </record>

    <record id="view_account_analytic_account_form" model="ir.ui.view">
        <field name="name">account.analytic.account.form.wbs</field>
        <field name="model">account.analytic.account</field>
        <field name="inherit_id" ref="analytic.view_account_analytic_account_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='main']/group[1]" position="inside">
                <field name="parent_id" />
                <field name="account_class" string="Class" />
                <field name="manager_id" />
                <field name="complete_wbs_code" string="WBS Code" readonly="1" />
            </xpath>
            <xpath expr="//group[@name='main']/group[2]" position="inside">
                <field name="project_analytic_id" />
                <field name="user_id" />
            </xpath>
        </field>
    </record>
</odoo>
