        <field name="name">Meeting Minutes - User Scope</field>
        <field name="model_id" ref="model_np_meeting_minutes"/>
        <field name="domain_force">
            ['|', '|', '|', '|', ('requested_by', '=', user.id), ('note_taker_id.user_id', '=', user.id), ('participant_ids.user_id', '=', user.id), ('approver_id', '=', user.id), ('department_id.manager_id.user_id', '=', user.id)]
