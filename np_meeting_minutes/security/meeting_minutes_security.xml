<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="group_meeting_minutes_user" model="res.groups">
            <field name="name">Meeting Minutes User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <record id="group_meeting_minutes_approver" model="res.groups">
            <field name="name">Meeting Minutes Approver</field>
            <field name="implied_ids" eval="[
                (4, ref('base.group_user')),
                (4, ref('np_meeting_minutes.group_meeting_minutes_user'))
            ]"/>
        </record>

        <record id="group_meeting_minutes_admin" model="res.groups">
            <field name="name">Meeting Minutes Admin</field>
            <field name="implied_ids" eval="[
                (4, ref('base.group_user')),
                (4, ref('np_meeting_minutes.group_meeting_minutes_user')),
                (4, ref('np_meeting_minutes.group_meeting_minutes_approver'))
            ]"/>
        </record>
    </data>
</odoo>
